# GTEMS OS Linux Kernel 6.6 LTS Kconfig Fragment (x86_64)
# Base técnica: Kernel Linux con endurecimiento de seguridad y soporte de escritorio

CONFIG_LOCALVERSION="-gtems-aurora"
CONFIG_DEFAULT_HOSTNAME="gtems-host"

# Preemption & Scheduling
CONFIG_PREEMPT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64

# Filesystems & Storage
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=m

# Networking, Wi-Fi & Firewall
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_ATH9K=m
CONFIG_BT=m

# Graphics, Audio & Input
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# Security & Isolation
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
